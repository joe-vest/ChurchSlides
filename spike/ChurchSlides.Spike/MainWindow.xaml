<Window x:Class="ChurchSlides.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChurchSlides spike" Width="1240" Height="760">
  <DockPanel>
    <!-- Top bar: automatic run, save, media folder -->
    <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button x:Name="RunAutoButton" Content="Run automatic tests" Padding="10,4" Click="RunAuto_Click" />
        <Button Content="Save results" Padding="10,4" Margin="8,0,0,0" Click="Save_Click" />
        <Button Content="Choose media folder…" Padding="10,4" Margin="8,0,0,0" Click="ChooseMedia_Click" DockPanel.Dock="Right" />
        <TextBlock x:Name="MediaFolderText" Margin="16,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" DockPanel.Dock="Right" MaxWidth="360" />
        <TextBlock x:Name="AutoStatusText" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Live readouts -->
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="MetricsText" FontFamily="Consolas" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <CheckBox x:Name="CountFramesBox" Content="Count frames (costs CPU)" Checked="CountFrames_Changed" Unchecked="CountFrames_Changed" />
      </StatusBarItem>
    </StatusBar>

    <TabControl x:Name="Tabs" Margin="4">
      <TabItem Header="System (S8)">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh" Padding="10,4" Click="RefreshSystem_Click" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Pass: it runs, and the render tier is 2 (hardware)." />
          </StackPanel>
          <DataGrid x:Name="SystemGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Figure" Binding="{Binding Name}" Width="220" />
              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Output (S1)">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="OutputPanel" Margin="8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Monitor:" VerticalAlignment="Center" />
              <ComboBox x:Name="MonitorBox" Width="360" Margin="8,0,0,0" />
              <Button Content="Refresh" Padding="10,4" Margin="8,0,0,0" Click="RefreshMonitors_Click" />
              <Button Content="Open test pattern" Padding="10,4" Margin="8,0,0,0" Click="OpenPattern_Click" />
              <Button Content="Close it" Padding="10,4" Margin="8,0,0,0" Click="ClosePattern_Click" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Opens a borderless window at the monitor's exact pixel bounds. The window rectangle is checked automatically. Look at the monitor and the projector for the eye checks." />
            <TextBlock x:Name="OutputResultText" Margin="0,8,0,0" FontFamily="Consolas" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="SlidesTab" Header="Slides (S2)">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="SlidesPanel" Margin="8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="RunSlidesButton" Content="Run slide test" Padding="10,4" Click="RunSlides_Click" />
              <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                         Text="About 2 minutes, all backgrounds: 60 Cuts, then 60 crossfades with pre-render on each thread. Part of the automatic run too." />
            </StackPanel>
            <TextBlock TextWrapping="Wrap"
                       Text="Opens the Output on the monitor chosen on the Output tab and steps through hymn slides over the chosen backgrounds. Backgrounds and fit apply when you open the Output. Keys while this tab or the Output has focus: Right/Left, B (Black), C (Clear), L (Logo, the file named logo.* in the media folder), Esc closes the Output." />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Backgrounds (select one or more):" />
                <ListBox x:Name="BackgroundList" Height="150" SelectionMode="Extended" Margin="0,4,8,0" />
              </DockPanel>
              <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Fit:" Width="90" VerticalAlignment="Center" />
                  <ComboBox x:Name="FitBox" Width="100" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBlock Text="Transition:" Width="90" VerticalAlignment="Center" />
                  <RadioButton x:Name="CutRadio" Content="Cut" GroupName="Transition" VerticalAlignment="Center" />
                  <RadioButton x:Name="FadeRadio" Content="Crossfade" GroupName="Transition" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" />
                  <Slider x:Name="FadeSlider" Minimum="100" Maximum="1000" Value="300" TickFrequency="50" IsSnapToTickEnabled="True" Width="160" Margin="12,0,0,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Value, ElementName=FadeSlider, StringFormat={}{0:F0} ms}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBlock Text="Pre-render:" Width="90" VerticalAlignment="Center" />
                  <RadioButton x:Name="UiThreadRadio" Content="UI thread" GroupName="PreRender" VerticalAlignment="Center" />
                  <RadioButton x:Name="RenderThreadRadio" Content="Render thread" GroupName="PreRender" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="Open Output" Padding="10,4" Click="OpenSlides_Click" />
                  <Button Content="Close Output" Padding="10,4" Margin="8,0,0,0" Click="CloseSlides_Click" />
                  <Button Content="◀ Previous" Padding="10,4" Margin="16,0,0,0" Click="Previous_Click" />
                  <Button Content="Next ▶" Padding="10,4" Margin="8,0,0,0" Click="Next_Click" />
                  <Button Content="Black" Padding="10,4" Margin="16,0,0,0" Click="Black_Click" />
                  <Button Content="Clear" Padding="10,4" Margin="8,0,0,0" Click="Clear_Click" />
                  <Button Content="Logo" Padding="10,4" Margin="8,0,0,0" Click="Logo_Click" />
                </WrapPanel>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="SlidesResultText" Margin="0,8,0,0" FontFamily="Consolas" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="RichTextTab" Header="Rich text (S3)" />

      <TabItem x:Name="AudioTab" Header="Audio (S4)" />

      <TabItem x:Name="TimerTab" Header="Timer (S5)" />

      <TabItem Header="Memory (S6)">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="RunMemoryButton" Content="Run memory test" Padding="10,4" Click="RunMemory_Click" />
              <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Pass: working set ≤ 300 MB while presenting (PLT-005)." />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Times decoding each background, then loads a typical Service (3 Songs, 5 Presentations, a Scripture item: 47 slides) with thumbnails, and presents it on the Output monitor with a 3-slide pre-render window. About a minute. Part of the automatic run too." />
            <TextBlock x:Name="MemoryResultText" Margin="0,8,0,0" FontFamily="Consolas" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Startup (S7)">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="StartupPanel" Margin="8">
            <TextBlock TextWrapping="Wrap"
                       Text="Every launch is timed from process start to the first frame and kept. For the figures: restart Windows, then start each build once (cold), then once more (warm). Start a copy with --kestrel (the shortcut in the README) to include the web server." />
            <TextBlock x:Name="ThisRunText" Margin="0,8,0,0" FontFamily="Consolas" TextWrapping="Wrap" />
            <DataGrid x:Name="StartupGrid" Margin="0,8,0,0" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="260">
              <DataGrid.Columns>
                <DataGridTextColumn Header="When" Binding="{Binding At, StringFormat=yyyy-MM-dd HH:mm}" />
                <DataGridTextColumn Header="Build" Binding="{Binding Build}" />
                <DataGridCheckBoxColumn Header="Kestrel" Binding="{Binding Kestrel}" />
                <DataGridTextColumn Header="Uptime (min)" Binding="{Binding UptimeMinutes, StringFormat=F0}" />
                <DataGridTextColumn Header="To Main (ms)" Binding="{Binding ToMainMs, StringFormat=F0}" />
                <DataGridTextColumn Header="Kestrel (ms)" Binding="{Binding KestrelMs, StringFormat=F0}" />
                <DataGridTextColumn Header="To first frame (ms)" Binding="{Binding ToFirstFrameMs, StringFormat=F0}" />
                <DataGridTextColumn Header="JIT methods" Binding="{Binding JitMethods}" />
                <DataGridTextColumn Header="JIT time (ms)" Binding="{Binding JitMs, StringFormat=F0}" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Results">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh preview" Padding="10,4" Click="RefreshPreview_Click" />
            <Button Content="Open results folder" Padding="10,4" Margin="8,0,0,0" Click="OpenFolder_Click" />
          </StackPanel>
          <TextBox x:Name="PreviewBox" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
